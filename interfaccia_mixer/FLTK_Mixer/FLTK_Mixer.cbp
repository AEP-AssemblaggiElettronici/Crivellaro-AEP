<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="FLTK_Mixer" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/FLTK_Mixer" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/FLTK_Mixer" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-s" />
				</Compiler>
			</Target>
		</Build>
		<Compiler>
			<Add option="`fltk-config --cxxflags`" />
			<Add directory="/usr/local/include" />
		</Compiler>
		<Linker>
			<Add option="`fltk-config --ldstaticflags`" />
			<Add library="wiringPi" />
			<Add directory="/usr/local/lib" />
		</Linker>
		<Unit filename="FLTK_Mixer.cbp" />
		<Unit filename="bottone_banco.cpp" />
		<Unit filename="bottone_banco.h" />
		<Unit filename="bottone_mixer.cpp" />
		<Unit filename="bottone_mixer.h" />
		<Unit filename="main.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
