        "name": "Controlla se c'è gia un orario di entrata",
        "func": "let caratteriProibiti = /['\";]/g;\nlet id = caratteriProibiti.test(msg.payload.id) ? msg.payload.id.replace(caratteriProibiti, \" \") : msg.payload.id;\nlet entrataUscita = id[0];\nid = parseInt(id.substring(1, 4));\n\nlet query = entrataUscita === \"E\" \n? \"SELECT * FROM orari WHERE id_dipendente = '\" + id + \"' AND USCITA IS NULL;\"\n: \"UPDATE orari SET uscita = datetime('now', 'localtime') WHERE id_dipendente = \" + id + \" AND uscita IS NULL;\";\n\nreturn { \n    \"topic\": query,\n    \"id\": id,\n    \"req\": msg.req,\n    \"res\": msg.res\n    };",
        "outputs": 1,
